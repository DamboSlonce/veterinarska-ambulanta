<Window x:Class="Veterinarska_Ambulanta_WPF.Prozori.Lekovi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VetKeep - Lekovi" Height="800" Width="1500" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">
    <Grid>
        <Button Content="Nazad" Margin="10,10,1394,734" Style="{StaticResource RoundedButton}" Click="ButtonNazad_Click"/>
        <Label Content="Lekovi" HorizontalAlignment="Center" Margin="0,23,0,0" VerticalAlignment="Top"
               Height="84" Width="228" FontFamily="Garamond" FontSize="60" FontWeight="Bold" Foreground="#C8F7C5"/>

        <Label Content="Naziv" Margin="85,161,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TextboxNaziv" Margin="30,196,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource RoundedTextBox}"/>

        <Label Content="Proizvođač" Margin="227,161,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TextboxProizvodjac" Margin="190,196,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource RoundedTextBox}"/>

        <Label Content="Jačina" Margin="403,161,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TextboxJacina" Margin="350,196,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource RoundedTextBox}"/>

        <Label Content="Doziranje" Margin="553,161,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TextboxDoziranje" Margin="510,196,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="157" Height="30" Style="{StaticResource RoundedTextBox}"/>

        <TextBox x:Name="TextboxIdLeka" Visibility="Hidden" HorizontalAlignment="Center" Margin="0,197,0,0" VerticalAlignment="Top" Style="{StaticResource RoundedTextBox}"/>

        <Button Content="Dodaj" Margin="926,193,418,538" Style="{StaticResource RoundedButton}" Background="#9DF16A" BorderBrush="Black" Click="ButtonDodaj_Click"/>
        <Button Content="Obriši" Margin="1113,193,231,538" Style="{StaticResource RoundedButton}" Background="#F17D5D" BorderBrush="Black" Click="ButtonObrisi_Click"/>
        <Button Content="Izmeni" Margin="1301,193,43,538" Style="{StaticResource RoundedButton}" BorderBrush="Black" Click="ButtonIzmeni_Click"/>

        <DataGrid Name="DataGrid" Style="{StaticResource AppGrid}" Margin="58,309,46,44" SelectionChanged="DataGrid_SelectionChanged_1">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding IDLeka}" Header="ID Leka" Width="*"/>
                <DataGridTextColumn Binding="{Binding Naziv}" Header="Naziv" Width="*"/>
                <DataGridTextColumn Binding="{Binding Proizvodjac}" Header="Proizvođač" Width="*"/>
                <DataGridTextColumn Binding="{Binding Jacina}" Header="Jačina" Width="*"/>
                <DataGridTextColumn Binding="{Binding Doziranje}" Header="Doziranje" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
