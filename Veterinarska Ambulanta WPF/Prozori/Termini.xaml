<Window x:Class="Veterinarska_Ambulanta_WPF.Prozori.Termini"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VetKeep - Termini" Height="800" Width="1500" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">
    <Grid>
        <Button Content="Nazad" Margin="10,10,1394,734" Style="{StaticResource RoundedButton}" Click="ButtonNazad_Click"/>
        <Label Content="Termini" Margin="624,23,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Height="84" Width="228" FontFamily="Garamond" FontSize="60" FontWeight="Bold" Foreground="#C8F7C5"/>

        <Label Content="Pacijent" Margin="67,153,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ComboboxPacijent" Margin="19,189,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="155" Height="26" Background="#C8F7C5" Loaded="ComboboxPacijent_Loaded"/>

        <Label Content="Veterinar" Margin="220,153,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ComboboxVeterinar" Margin="179,189,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="155" Height="26" Background="#C8F7C5" Loaded="ComboboxVeterinar_Loaded"/>

        <Label Content="Datum" Margin="390,153,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="DatepickerDatum" Margin="339,187,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="31" Width="154" FirstDayOfWeek="Monday"/>

        <Label Content="Vreme" Margin="551,153,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TextboxVreme" Margin="498,188,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource RoundedTextBox}"/>

        <Label Content="Vrsta usluge" Margin="694,153,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TextboxVrstaUsluge" Margin="660,187,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Style="{StaticResource RoundedTextBox}"/>

        <TextBox x:Name="TextboxIdTermina" Visibility="Hidden" Margin="21,258,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource RoundedTextBox}"/>

        <ComboBox x:Name="FiltrirajTermineComboBox" Margin="19,236,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="155" Height="26" SelectionChanged="FiltrirajTermineComboBox_SelectionChanged">
            <ComboBoxItem>Sve</ComboBoxItem>
            <ComboBoxItem>Danas</ComboBoxItem>
            <ComboBoxItem>7 dana</ComboBoxItem>
            <ComboBoxItem>30 dana</ComboBoxItem>
        </ComboBox>

        <Button Content="Dodaj" Margin="922,185,422,546" Style="{StaticResource RoundedButton}" Background="#9DF16A" BorderBrush="Black" Click="ButtonDodaj_Click"/>
        <Button Content="Obriši" Margin="1109,185,235,546" Style="{StaticResource RoundedButton}" Background="#F17D5D" BorderBrush="Black" Click="ButtonObrisi_Click"/>
        <Button Content="Izmeni" Margin="1297,185,47,546" Style="{StaticResource RoundedButton}" BorderBrush="Black" Click="ButtonIzmeni_Click"/>

        <DataGrid Name="DataGrid" Style="{StaticResource AppGrid}" Margin="58,309,46,44" SelectionChanged="DataGrid_SelectionChanged_1">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding IDTermina}" Header="ID termina" Width="*"/>
                <DataGridTextColumn Binding="{Binding IDPacijenta}" Header="ID pacijenta" Width="*"/>
                <DataGridTextColumn Binding="{Binding IDVeterinara}" Header="ID veterinara" Width="*"/>
                <DataGridTextColumn Binding="{Binding Datum, StringFormat=\{0:yyyy-MM-dd\}}" Header="Datum" Width="*"/>
                <DataGridTextColumn Binding="{Binding Vreme}" Header="Vreme" Width="*"/>
                <DataGridTextColumn Binding="{Binding VrstaUsluge}" Header="Vrsta usluge" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
