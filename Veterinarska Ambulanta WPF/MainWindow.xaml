<Window x:Class="Veterinarska_Ambulanta_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VetKeep - Login" Height="500" Width="800" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">
    <Grid>
        <Label Content="Ulogujte se" HorizontalAlignment="Center" Margin="0,20,0,0" VerticalAlignment="Top"
               Height="84" Width="400" FontFamily="Garamond" FontSize="60" FontWeight="Bold" Foreground="#C8F7C5"/>
        <Label Content="Korisničko ime:" HorizontalAlignment="Left" Margin="189,158,0,0" VerticalAlignment="Top"
               Style="{StaticResource FieldLabel}" Background="#2E7D5B"/>
        <TextBox x:Name="TextboxKorisnickoIme" HorizontalAlignment="Center" Margin="0,158,0,0" VerticalAlignment="Top"
                 Style="{StaticResource RoundedTextBox}" Background="White"/>
        <Label Content="Lozinka:" HorizontalAlignment="Left" Margin="212,0,0,0" VerticalAlignment="Center"
               Style="{StaticResource FieldLabel}" Background="#2E7D5B"/>
        <PasswordBox x:Name="PasswordfieldLozinka" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Width="156" Height="29" Style="{StaticResource RoundedPassword}" Background="White"/>
        <Button x:Name="ButtonUlogujteSe" Content="Ulogujte se" Margin="322,304,322,127"
                Style="{StaticResource RoundedButton}" Click="Button_Click"/>
    </Grid>
</Window>
